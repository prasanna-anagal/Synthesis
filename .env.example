# Synthesis Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit the .env file.

# ─── Groq API ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Default model used for reasoning and chat (swappable without code changes)
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# ─── Backend ─────────────────────────────────────────────────────────────────
# Secret used to sign/verify internal tokens if needed
SECRET_KEY=change_this_to_a_random_secret_string

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_db

# ─── CORS (Frontend URL for local dev) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173
